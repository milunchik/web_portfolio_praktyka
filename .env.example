# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before starting containers: `cp .env.example .env`
# ==============================================================================

# Application Environment (prod | dev | test)
NODE_ENV=prod

# --- Network & Domains ---
PORT=3001
WEB_PORT=3000

# Public URLs (Replace with your server's domain or public IP)
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
API_URL=http://api:3001

# --- CORS Settings ---
CORS_ORIGIN=http://localhost:3000
CORS_ENABLED=true
CREDENTIALS=true

# --- Database (PostgreSQL & Prisma) ---
# Example for Docker internal Postgres: postgresql://postgres:postgres@postgres:5432/portfolio?schema=public
# Example for Host Postgres: postgresql://postgres:password@host.docker.internal:5432/portfolio?schema=public
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/portfolio?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portfolio
POSTGRES_PORT=5432
POSTGRES_HOST=host.docker.internal

# --- Storage (Supabase) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_BUCKET=media

# --- Authentication & JWT Security ---
JWT_SECRET=generate_a_random_32_or_64_character_string_for_production
JWT_REFRESH_SECRET=generate_another_random_secret_for_refresh_tokens
JWT_SECRET_LIFE_TIME=15m
JWT_REFRESH_LIFE_TIME=7d
MAX_COUNT_SESSIONS=5

# --- Cache & Redis (Optional) ---
CACHE=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=300
REDIS_USERNAME=
REDIS_PASSWORD=

# --- Mail & Background Worker (Optional) ---
MAIL_PROVIDER=noop
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@example.com
MAIL_WORKER_ENABLED=false
MAIL_WORKER_INTERVAL_MS=1000
MAIL_WORKER_BATCH_SIZE=10
