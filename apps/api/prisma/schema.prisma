generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  user
}

enum AnalyticsEventType {
  profile_view
  cv_download
  contact_click
  project_click
  social_link_click
}

enum AnalyticsVisitorType {
  authenticated
  anonymous
}

model User {
  id          Int     @id @default(autoincrement())
  email       String  @unique
  fullName    String  @unique @db.VarChar(50)
  description String? @db.VarChar(500)
  about       String? @db.VarChar(1500)
  password    String
  publicUrl   String  @unique
  role        Role    @default(user)
  fileName    String?
  cvOptions   Json?
  location    String? @db.VarChar(100)
  website     String? @db.VarChar(200)
  github      String? @db.VarChar(100)
  linkedin    String? @db.VarChar(100)
  twitter     String? @db.VarChar(100)
  dribbble    String? @db.VarChar(100)

  sessions   Session[]
  education  Education[]
  experience Experience[]
  projects   Project[]
  medias     Media[]
  languages  LanguageUser[]

  analyticsEventsReceived AnalyticsEvent[] @relation("UserPortfolioAnalytics")
  analyticsEventsCreated  AnalyticsEvent[] @relation("UserVisitorAnalytics")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt()

  @@map("user")
}

model Experience {
  id          Int       @id @default(autoincrement())
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  company     String    @db.VarChar(100)
  position    String    @db.VarChar(30)
  description String    @db.VarChar(300)
  startDate   DateTime
  endDate     DateTime?
  skills      String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([company])
  @@index([position])
  @@map("experience")
}

enum EducationDegree {
  bachelor
  master
}

model Education {
  id        Int             @id @default(autoincrement())
  userId    Int
  user      User            @relation(fields: [userId], references: [id])
  title     String          @db.VarChar(50)
  degree    EducationDegree @default(bachelor)
  startDate DateTime
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
  @@map("education")
}

model Project {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id])

  title       String @db.VarChar(50)
  description String @db.VarChar(500)

  analyticsEvents AnalyticsEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("projecct")
}

enum LanguageLevel {
  elementary
  pre_intermediate
  intermediate
  upper_intermediate
  advanced
}

model Language {
  id Int @id @default(autoincrement())

  name  String         @db.VarChar(50)
  level LanguageLevel
  users LanguageUser[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@map("language")
}

model LanguageUser {
  id         Int @id @default(autoincrement())
  userId     Int
  languageId Int

  user     User     @relation(fields: [userId], references: [id])
  language Language @relation(fields: [languageId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, languageId])
  @@map("language_user_relation")
}

model Session {
  id                    Int       @id @default(autoincrement())
  userId                Int
  refreshToken          String    @unique
  accessToken           String    @unique
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  deviceId              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([refreshToken])
  @@index([deviceId])
  @@map("session")
}

model Media {
  id       Int    @id @default(autoincrement())
  userId   Int
  url      String
  fileName String
  mimeType String
  size     Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([url])
  @@index([fileName])
  @@map("media")
}

model AnalyticsEvent {
  id                 Int                  @id @default(autoincrement())
  portfolioOwnerId   Int
  portfolioOwner     User                 @relation("UserPortfolioAnalytics", fields: [portfolioOwnerId], references: [id], onDelete: Cascade)
  visitorUserId      Int?
  visitorUser        User?                @relation("UserVisitorAnalytics", fields: [visitorUserId], references: [id], onDelete: SetNull)
  anonymousVisitorId String?              @db.VarChar(100)
  visitorType        AnalyticsVisitorType
  eventType          AnalyticsEventType
  projectId          Int?
  project            Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  target             String?              @db.VarChar(100)
  createdAt          DateTime             @default(now())

  @@index([portfolioOwnerId])
  @@index([eventType])
  @@index([createdAt])
  @@index([portfolioOwnerId, eventType, createdAt])
  @@index([portfolioOwnerId, visitorType])
  @@index([portfolioOwnerId, visitorUserId])
  @@index([portfolioOwnerId, anonymousVisitorId])
  @@map("analytics_event")
}
