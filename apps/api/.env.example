NODE_ENV=dev
PORT=3001
WEB_URL=http://localhost:3000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_ENABLED=true
CREDENTIALS=true

# Database (PostgreSQL & Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portfolio?schema=public
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portfolio
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Storage (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_BUCKET=media

# Authentication & JWT
JWT_SECRET=super_secret_jwt_key_change_in_production_12345
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_change_in_production_12345
JWT_SECRET_LIFE_TIME=15m
JWT_REFRESH_LIFE_TIME=7d
MAX_COUNT_SESSIONS=5

# Cache & Redis
CACHE=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=300
REDIS_USERNAME=
REDIS_PASSWORD=

# Mail & Background Worker
MAIL_PROVIDER=noop
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM=no-reply@example.com
MAIL_WORKER_ENABLED=false
MAIL_WORKER_INTERVAL_MS=1000
MAIL_WORKER_BATCH_SIZE=10
